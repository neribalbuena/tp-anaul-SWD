<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<nav class="menu">
    <a href="/">Inicio</a>
    <a href="#">Administrador</a>
</nav>


<section class="catalogo">
    <% productos.forEach(producto => { %>
    <article class="producto">
        <h3><%= producto.nombre %></h3>
        <img src="<%= producto.imagen%>">
        <p><%= producto.descripcion %></p>
        <p><%= producto.precio %>$</p>
        <p><%= producto.stock %></p>  
    </article>
<% }) %>
</section>
</body>
</html>