<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Administrar productos | Catálogo de compras</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="menu">
    <a href="/">Inicio</a>
    <a href="/productos">Catálogo</a>
    <a href="/admin/productos">Administrar productos</a>
    <a href="/admin/productos/nuevo">Nuevo producto</a>
</nav>

<main class="pagina-productos">
    <div class="encabezado-admin">
        <h1>Administrar productos</h1>
        <a class="boton-admin" href="/admin/productos/nuevo">Nuevo producto</a>
    </div>

    <% if (success === 'creado') { %>
    <p class="mensaje mensaje-exito" role="status">Producto creado correctamente.</p>
    <% } else if (success === 'actualizado') { %>
    <p class="mensaje mensaje-exito" role="status">Producto actualizado correctamente.</p>
    <% } else if (success === 'eliminado') { %>
    <p class="mensaje mensaje-exito" role="status">Producto eliminado correctamente.</p>
    <% } %>

    <div class="tabla-contenedor">
        <table class="tabla-admin">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% if (productos.length === 0) { %>
                <tr><td colspan="6">Todavía no hay productos.</td></tr>
                <% } %>
                <% productos.forEach(producto => { %>
                <tr>
                    <td><%= producto.id %></td>
                    <td><%= producto.nombre %></td>
                    <td><%= producto.descripcion %></td>
                    <td><%= producto.precio %></td>
                    <td><%= producto.stock %></td>
                    <td class="acciones-admin">
                        <a class="boton-admin boton-secundario" href="/admin/productos/editar/<%= producto.id %>">Editar</a>
                        <form action="/admin/productos/eliminar/<%= producto.id %>" method="post"
                            onsubmit="return confirm('¿Eliminar este producto? Esta acción no se puede deshacer.');">
                            <label class="solo-lectores" for="admin-password-<%= producto.id %>">Contraseña de administrador</label>
                            <input id="admin-password-<%= producto.id %>" name="admin_password" type="password"
                                placeholder="Contraseña" autocomplete="current-password" required>
                            <button class="boton-admin boton-peligro" type="submit">Eliminar</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</main>
</body>
</html>
