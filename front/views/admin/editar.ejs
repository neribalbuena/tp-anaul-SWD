<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QuickShop - Editar Producto</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <header class="navbar">
    <div class="logo"> QuickShop Admin</div>
    <nav>
      <a href="/">Ir a la Tienda</a>
      <a href="/admin/productos" class="active">Productos</a>
    </nav>
  </header>

  <main class="container">
    <div class="form-card">
      <h2>Editar producto</h2>

      <form action="/admin/productos/editar/1" method="POST">
        <div class="form-group">
          <label for="nombre">Nombre *</label>
          <input type="text" id="nombre" name="nombre" value="Refresco" required>
        </div>

        <div class="form-group">
          <label for="categoria">Categoría *</label>
          <select id="categoria" name="categoria" required>
            <option value="Bebidas" selected>Bebidas</option>
            <option value="Almacén">Almacén</option>
            <option value="Limpieza">Limpieza</option>
            <option value="Lácteos">Lácteos</option>
          </select>
        </div>

        <div class="form-row">
          <div class="form-group col">
            <label for="precio">Precio ($) *</label>
            <input type="number" id="precio" name="precio" value="2500" min="0" step="0.01" required>
          </div>

          <div class="form-group col">
            <label for="stock">Stock *</label>
            <input type="number" id="stock" name="stock" value="25" min="0" required>
          </div>
        </div>

        <div class="form-group">
          <label for="imagen">URL de la imagen</label>
          <input type="text" id="imagen" name="imagen" value="/images/refresco.png">
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Guardar cambios</button>
          <a href="/admin/productos" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </main>

</body>
</html>