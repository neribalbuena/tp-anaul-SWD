<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Editar producto | Catálogo de compras</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="menu">
    <a href="/">Inicio</a>
    <a href="/productos">Catálogo</a>
    <a href="/admin/productos">Administrar productos</a>
    <a href="/admin/productos/nuevo">Nuevo producto</a>
</nav>

<main class="pagina-productos">
    <section class="formulario-producto">
        <h1>Editar producto</h1>
        <% if (error) { %>
        <p class="mensaje mensaje-error" role="alert"><%= error %></p>
        <% } %>
        <form action="/admin/productos/editar/<%= producto.id %>" method="post">
            <label for="nombre">Nombre</label>
            <input id="nombre" name="nombre" type="text" maxlength="200" required
                value="<%= producto.nombre || '' %>">

            <label for="descripcion">Descripción</label>
            <textarea id="descripcion" name="descripcion" rows="3" required><%= producto.descripcion || '' %></textarea>

            <label for="precio">Precio</label>
            <input id="precio" name="precio" type="number" min="0" step="0.01" required
                value="<%= producto.precio ?? '' %>">

            <label for="stock">Stock</label>
            <input id="stock" name="stock" type="number" min="0" step="1" required
                value="<%= producto.stock ?? '' %>">

            <label for="imagen_url">URL de imagen (opcional)</label>
            <input id="imagen_url" name="imagen_url" type="url"
                placeholder="URL de una imagen en el bucket prod-img"
                value="<%= producto.imagen_url || '' %>">
            <p class="ayuda-formulario">La imagen debe estar en el bucket privado prod-img de Supabase.</p>

            <label for="admin_password">Contraseña de administrador</label>
            <input id="admin_password" name="admin_password" type="password"
                autocomplete="current-password" required>

            <div class="acciones-formulario">
                <button type="submit">Guardar cambios</button>
                <a class="boton-admin boton-secundario" href="/admin/productos">Cancelar</a>
            </div>
        </form>
    </section>
</main>
</body>
</html>
