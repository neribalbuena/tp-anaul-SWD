<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Administración de productos</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <header>
    <nav>
      <a href="/">Ir a la Tienda</a>
      <a href="/admin/productos">Productos</a>
    </nav>
  </header>

  <main>
    <div>
      <h2>Administración de productos</h2>
      <a href="/admin/productos/nuevo" class="btn">+ Nuevo producto</a>
    </div>

    <div>
      <table border="1">
        <thead>
          <tr>
            <th>ID</th>
            <th>Imagen</th>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (productos && productos.length > 0) { %>
            <% productos.forEach(prod => { %>
              <tr>
                <td><%= prod.id %></td>
                <td>
                  <img src="<%= prod.imagen %>" alt="<%= prod.nombre %>" style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;">
                </td>
                <td><%= prod.nombre %></td>
                <td><%= prod.categoria %></td>
                <td>$ <%= prod.precio %></td>
                <td><%= prod.stock %></td>
                <td>
                  <a href="/admin/productos/editar/<%= prod.id %>">Editar</a>
                  <form action="/admin/productos/eliminar/<%= prod.id %>" method="POST" style="display:inline;">
                    <button type="submit" onclick="return confirm('¿Estás seguro de eliminar este producto?')">Eliminar</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" style="text-align: center;">No hay productos cargados en la base de datos.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>

</body>
</html>