<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<section class="fondo"> 
<section class="detalles">
    <img  src="<%= producto.imagen %>">
<article class="info">
    <h3><%= producto.nombre %></h3>
    <p class="marca">coca cola</p>
    <hr>
    <p>categoria: <%= producto.descripcion %></p>
    <p>stock: <%= producto.stock %></p>
    <p>$<%= producto.precio %></p>
</article>
</section>
</section>
<style>


.fondo {
    background-image: url("/img/fondo.jpg");
    background-size: cover;
    background-position: center;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
}

.detalles {
    display: flex;
    align-items: center;
    gap: 20px;
    background: white;
    padding: 30px;
    width: 900px;
}

.detalles img {
    width: 600px;
    height: 600px;
}

.info {
    padding: 10px;
}

.info h3 {
    font-size: 30px;
}

.info p {
    font-size: 18px;
    margin: 15px 0;
}

.marca {
    color: rgb(211, 97, 97);
}

</style>
</body>
</html>
